# This file contains example variables that can be set in a .env file for this
# repository. You may need to specify some or all depending on your local
# environment.

SBATCH_ACCOUNT= # slurm account if not using default account
SBATCH_PARTITION= # partition to use for slurm jobs (required if your cluster does not have a default partition)
GRB_LICENSE_FILE= # path to Gurobi license file if not in default location
DIAMOND= # path to DIAMOND binary. If not specified, assumed to be on PATH
PYTHON= # path to virtual environment python interpreter (if not specified, assumed to be at ./.venv/bin/python)
